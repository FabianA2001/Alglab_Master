#!/usr/bin/env bash

# Run frontend (npm start) and Streamlit together.
# - Frontend runs in background
# - Streamlit runs in foreground
# On exit, the frontend process is cleaned up.

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"

# Adjust this path if your frontend lives elsewhere
FRONTEND_DIR="$REPO_ROOT/src/gui/pages/component_solution/my_component/frontend"
STREAMLIT_ENTRY="$REPO_ROOT/run_gui.py"

log() { printf "\033[1;34m[gui]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[warn]\033[0m %s\n" "$*"; }
err() { printf "\033[1;31m[err]\033[0m %s\n" "$*"; }

require_cmd() {
	if ! command -v "$1" >/dev/null 2>&1; then
		err "Required command '$1' not found. Please install it and retry."
		exit 1
	fi
}

cleanup() {
	local code=$?
	if [[ -n "${FRONTEND_PID:-}" ]] && ps -p "$FRONTEND_PID" >/dev/null 2>&1; then
		log "Stopping frontend (PID $FRONTEND_PID)"
		kill "$FRONTEND_PID" >/dev/null 2>&1 || true
		# Give it a moment to exit gracefully
		sleep 1
		if ps -p "$FRONTEND_PID" >/dev/null 2>&1; then
			kill -9 "$FRONTEND_PID" >/dev/null 2>&1 || true
		fi
	fi
	exit "$code"
}
trap cleanup EXIT INT TERM

start_frontend() {
	if [[ ! -d "$FRONTEND_DIR" ]]; then
		err "Frontend directory not found: $FRONTEND_DIR"
		err "Update FRONTEND_DIR inside 'gui' to the correct path."
		exit 1
	fi

	pushd "$FRONTEND_DIR" >/dev/null
	if [[ -f package-lock.json && ! -d node_modules ]]; then
		log "Installing npm dependencies (npm ci)"
		npm ci
	elif [[ ! -d node_modules ]]; then
		warn "node_modules not found — running 'npm install'"
		npm install
	fi

	log "Starting frontend: npm start"
	# Run in background; logs will appear in this terminal
	npm start &
	FRONTEND_PID=$!
	log "Frontend started with PID $FRONTEND_PID"
	popd >/dev/null
}

start_streamlit() {
	if [[ ! -f "$STREAMLIT_ENTRY" ]]; then
		err "Streamlit entry not found: $STREAMLIT_ENTRY"
		exit 1
	fi
	log "Starting Streamlit: streamlit run $STREAMLIT_ENTRY"
	pushd "$REPO_ROOT" >/dev/null
	streamlit run "$STREAMLIT_ENTRY"
	popd >/dev/null
}

# Checks
require_cmd npm
require_cmd streamlit

start_frontend
sleep 1
start_streamlit